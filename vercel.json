{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/@google/genai/**"
    }
  },
  "rewrites": [
    {
      "source": "/firebase-messaging-sw.js",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
