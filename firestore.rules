rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Personal private collections for users
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Community public shared areas for "Dzô Quán tủ"
    match /public_venues/{venueId} {
      allow read: if true; // Everyone (even unlogged visitors) can view shared venues
      
      // Creating public shared venues - requires authentication
      allow create: if request.auth != null
                    && request.resource.data.name is string
                    && request.resource.data.address is string
                    && request.resource.data.sharedByUid == request.auth.uid;
                    
      // Updates allowed either for owner or for any user correcting overall rating averages upon review addition
      allow update: if request.auth != null && (
        resource.data.sharedByUid == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingsCount'])
      );
      
      allow delete: if request.auth != null && resource.data.sharedByUid == request.auth.uid;
      
      // Nested client-safe subcollection of reviews and scores
      match /reviews/{reviewId} {
        allow read: if true; // Publicly viewable
        
        allow create: if request.auth != null 
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.rating >= 1 
                      && request.resource.data.rating <= 5;
                      
        allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }
    
    // FCM Push Notification Tokens mapping
    match /user_fcm_tokens/{tokenDoc} {
      allow read: if true;
      allow create, update: if request.resource.data.tokens is list 
                            && request.resource.data.tokens.size() <= 20;
    }
  }
}
