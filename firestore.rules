rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Personal private collections for users
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Community public shared areas for "Dzô Quán tủ"
    match /public_venues/{venueId} {
      allow read: if true; // Everyone (even unlogged visitors) can view shared venues
      
      // Creating public shared venues - requires authentication
      allow create: if request.auth != null
                    && request.resource.data.name is string
                    && request.resource.data.address is string
                    && request.resource.data.sharedByUid == request.auth.uid;
                    
      // Rating aggregates are derived from reviews; untrusted clients cannot edit them.
      allow update: if request.auth != null
        && resource.data.sharedByUid == request.auth.uid
        && request.resource.data.sharedByUid == resource.data.sharedByUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'notes', 'sharedByName']);

      allow delete: if request.auth != null && resource.data.sharedByUid == request.auth.uid;
      
      // Nested client-safe subcollection of reviews and scores
      match /reviews/{reviewId} {
        allow read: if true; // Publicly viewable
        
        allow create: if request.auth != null
                      && reviewId == request.auth.uid
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.rating >= 1 
                      && request.resource.data.rating <= 5;
                      
        allow update: if request.auth != null
          && reviewId == request.auth.uid
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null
          && reviewId == request.auth.uid
          && resource.data.authorId == request.auth.uid;
      }
    }
    
    // Legacy public token directory is permanently closed.
    // Owner-scoped records now live under users/{uid}/fcm/tokens.
    match /user_fcm_tokens/{tokenDoc} {
      allow read, write: if false;
    }

    // Link possession only grants a single-document lookup, never collection listing.
    match /public_bills/{billId} {
      allow get: if !('revokedAt' in resource.data)
        && ('expiresAt' in resource.data)
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == billId
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 100
        && request.resource.data.totalAmount is number
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.id == billId
        && !('revokedAt' in resource.data)
        && ('expiresAt' in resource.data)
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
        && request.resource.data.expiresAt == resource.data.expiresAt
        && (
          // Only owner can transition link to revoked status.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt'])
          ||
          (request.resource.data.members is list
            && request.resource.data.members.size() <= 100
            && request.resource.data.expiresAt is timestamp)
        );
      // Never delete a tombstone: a deleted document could be recreated at the same ID.
      allow delete: if false;
    }
  }
}
